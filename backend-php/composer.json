{
    "name": "zapcore/gateway",
    "description": "ZapCore Gateway - WhatsApp Web API",
    "license": "proprietary",
    "type": "project",
    "require": {
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    }
}
